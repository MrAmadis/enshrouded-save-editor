<span class="number-field">
    <input type="text" inputmode="numeric" value="@_text" disabled="@Disabled" @onchange="OnChange" aria-invalid="@(_error is not null)" />
    @if (_error is not null)
    {
        <span class="field-error">@_error</span>
    }
</span>

@code {
    [Parameter] public long Value { get; set; }
    [Parameter] public long Min { get; set; } = long.MinValue;
    [Parameter] public long Max { get; set; } = long.MaxValue;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<long> OnCommit { get; set; }

    private string _text = "";
    private string? _error;

    protected override void OnParametersSet()
    {
        if (_error is null)
            _text = Value.ToString(CultureInfo.InvariantCulture);
    }

    private async Task OnChange(ChangeEventArgs e)
    {
        _text = e.Value?.ToString()?.Trim() ?? "";
        if (!long.TryParse(_text, NumberStyles.AllowLeadingSign, CultureInfo.InvariantCulture, out var value))
        {
            _error = "Enter a whole number";
            return;
        }
        if (value < Min || value > Max)
        {
            _error = $"Enter a number from {Min} to {Max}";
            return;
        }
        _error = null;
        await OnCommit.InvokeAsync(value);
    }
}
