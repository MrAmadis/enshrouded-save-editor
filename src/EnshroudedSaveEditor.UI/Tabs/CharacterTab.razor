@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject EditorService EditorService
@inject IJSRuntime JS

@{
    var s = EditorService.Current;
    var p = s.Points;
}
<div class="character-tab" @ref="_tab">
    <section class="panel">
        <h3>Character</h3>
        <label class="field-row">
            <span class="field-label">Name</span>
            <input type="text" class="name-field" value="@s.Name" disabled="@s.ReadOnly" aria-invalid="@(_nameError is not null)" @onchange="OnName" />
            <span class="name-limit muted">@CharacterEditor.MaxNameLength characters at most</span>
        </label>
        @if (_nameError is not null)
        {
            <div class="field-error name-error">@_nameError</div>
        }

        <div class="field-row">
            <span class="field-label">Level</span>
            <div class="level-stepper">
                <Stepper Value="s.Level" Min="1" Max="s.LevelCap" ShowMax="true" Disabled="s.ReadOnly" OnCommit="OnLevel" />
            </div>
        </div>
        @if (_levelError is not null)
        {
            <div class="field-error">@_levelError</div>
        }

        <div class="field-row">
            <span class="field-label">XP</span>
            <span class="xp-field">
                <NumberField Value="s.Xp" Min="0" Max="uint.MaxValue" Disabled="s.ReadOnly" OnCommit="OnXp" />
            </span>
            @if (s.XpToNextLevel is { } need && s.Level < s.LevelCap)
            {
                <span class="xp-next muted">of @need to level @(s.Level + 1)</span>
            }
        </div>
        @if (_xpError is not null)
        {
            <div class="field-error">@_xpError</div>
        }
    </section>

    <section class="panel">
        <h3>Skill points</h3>
        <dl class="points">
            <dt>From levels</dt><dd data-points="From levels">@p.FromLevels</dd>
            <dt>Elixir Wells &amp; Shroud Roots</dt><dd data-points="Elixir Wells &amp; Shroud Roots">@p.FromRewards</dd>
            <dt>Spent</dt><dd data-points="Spent">@p.Spent</dd>
            <dt>Available</dt><dd data-points="Available" class="@(p.Available < 0 ? "negative" : "")">@p.Available</dd>
        </dl>
        @if (p.Available < 0)
        {
            <Banner Kind="error"><span class="overspend">Your skills cost more than this level gives. Refund skills first.</span></Banner>
        }
    </section>
</div>

@code {
    private string? _nameError;
    private string? _levelError;
    private string? _xpError;

    private ElementReference _tab;
    private IJSObjectReference? _fit;

    protected override void OnInitialized() => EditorService.Changed += OnChanged;

    /// <summary>The tab grows with the window (fit.js "window" mode), but doesn't fill it.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        try
        {
            _fit = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/EnshroudedSaveEditor.UI/fit.js");
            await _fit.InvokeVoidAsync("attach", _tab, "window");
        }
        catch (JSException)
        {
            // The tab still works, at its natural size.
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        EditorService.Changed -= OnChanged;
        if (_fit is null)
            return;
        try
        {
            await _fit.InvokeVoidAsync("detach", _tab);
            await _fit.DisposeAsync();
        }
        catch (Exception e) when (e is JSDisconnectedException or JSException or ObjectDisposedException)
        {
        }
    }

    private void OnName(ChangeEventArgs e)
    {
        var name = (e.Value?.ToString() ?? "").Trim();
        if (name == EditorService.Current.Name)
        {
            _nameError = null;
            return;
        }
        _nameError = Try(() => EditorService.SetName(name));
    }

    private void OnLevel(long level)
    {
        if (level == EditorService.Current.Level)
            return;
        _levelError = Try(() => EditorService.SetLevel((int)level));
    }

    private void OnXp(long xp)
    {
        if (xp == EditorService.Current.Xp)
            return;
        _xpError = Try(() => EditorService.SetXp(xp));
    }

    private static string? Try(Action edit)
    {
        try
        {
            edit();
            return null;
        }
        catch (EditRejectedException e)
        {
            return e.Message;
        }
    }
}
